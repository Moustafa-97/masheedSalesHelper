# PostgreSQL connection (local, or a free Neon/Supabase database)
DATABASE_URL=postgres://sales:sales@localhost:5432/sales_dev
# Set to true for hosted databases that require SSL (Neon, Supabase)
DATABASE_SSL=false
# At least 32 bytes: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-32-byte-secret-value
# Where the web app runs (comma-separated for several)
WEB_ORIGIN=http://localhost:3000
PORT=4000
# true in production (HTTPS)
COOKIE_SECURE=false
# Used by `npm run seed` to create the first admin
ADMIN_NAME=Moustafa Adel
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please
