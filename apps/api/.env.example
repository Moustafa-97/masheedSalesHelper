# PostgreSQL connection (local, or a free Neon database)
DATABASE_URL=postgres://sales:sales@localhost:5432/sales_dev
# Neon only: the direct (non-pooled) URL, used for migrations and seeding
# DATABASE_URL_UNPOOLED=
# Only for hosts whose URL has no sslmode and that need SSL (Neon URLs already carry sslmode=require)
DATABASE_SSL=false
# At least 32 bytes: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-32-byte-secret-value
# Where the web app runs (comma-separated for several)
WEB_ORIGIN=http://localhost:3000
PORT=4000
# true in production (HTTPS)
COOKIE_SECURE=false
# Used by `npm run seed` to create the first admin
ADMIN_NAME=Moustafa Adel
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please

# Where uploaded files are kept (default ./uploads next to the API)
# UPLOAD_DIR=
